{
  "name": "lexical_probe_v1",
  "note": "Frozen item set and carrier probes for the first native-closeness measurement. All 80 items are exactly one leading-space token in every listed system (checked 2026-08-27). Probes: 4 semantic blocks x 4 paraphrases; slot marked by <X>; the next-token law is read after the suffix.",
  "systems": ["Qwen/Qwen3-0.6B", "Qwen/Qwen2.5-0.5B", "google/gemma-3-270m", "HuggingFaceTB/SmolLM2-360M", "EleutherAI/pythia-410m"],
  "items": {
