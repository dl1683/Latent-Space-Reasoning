    "verb": ["run","walk","eat","write","build","break","sleep","think","speak","fly","carry","push","open","close","drive","sing","throw","hold","learn","wash"],
    "adj":  ["red","blue","big","small","hot","cold","fast","slow","happy","sad","dark","bright","heavy","soft","loud","quiet","old","young","wet","empty"],
    "func": ["the","of","and","but","because","if","with","from","under","between","although","while","after","before","into","through","without","until","since","than"]
