    {"block": "association",  "name": "assoc_1", "template": "When I think of <X>, I think of"},
    {"block": "association",  "name": "assoc_2", "template": "Things related to <X> include"},
    {"block": "association",  "name": "assoc_3", "template": "The word <X> reminds me of"},
    {"block": "association",  "name": "assoc_4", "template": "People usually associate <X> with"},
    {"block": "grammar",      "name": "gram_1",  "template": "Yesterday they <X> and then"},
