   "near_far_gap_min": 0.8
  },
  "swap": {
   "top1_min": 0.75,
   "decision4_min": 0.65,
   "uplift_min": 0.25,
   "mass_uplift_nat_min": 0.5,
   "swap_over_self_min": 0.8,
